{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path((?!data/info\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "reiserad.no"
        }
      ],
      "destination": "https://xn--reiserd-jxa.no/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!data/info\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.reiserad.no"
        }
      ],
      "destination": "https://xn--reiserd-jxa.no/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!data/info\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.xn--reiserd-jxa.no"
        }
      ],
      "destination": "https://xn--reiserd-jxa.no/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!data/info\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.reiseråd.no"
        }
      ],
      "destination": "https://xn--reiserd-jxa.no/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/info.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<h>.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
